OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=your-local-model-name
OUTPUT_DIR=reports
DATABASE_PATH=data/market_digest.db
LOG_DIR=logs
TIMEZONE=Asia/Kolkata
STRICT_DATA_VALIDATION=true
RUN_MODE=live
REQUEST_TIMEOUT_SECONDS=20
MAX_RETRIES=2

# Gmail SMTP delivery (use a Google App Password, never your account password)
EMAIL_FROM=your-sender@gmail.com
EMAIL_TO=your-recipient@example.com
GMAIL_APP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
